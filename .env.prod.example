# Copy to .env on the production host and fill in. NEVER commit the real .env.
#   cp .env.prod.example .env

# ---- Public domain (for HTTPS via Caddy) ----
ARANDU_DOMAIN=arandu.cc

# ---- Metabase admin (created on first boot; also used by the frontend proxy) ----
MB_EMAIL=admin@arandu.cc
MB_PASSWORD=change-me-strong-password

# ---- Metabase's own app database (local Postgres on this host) ----
MB_DB_PASS=change-me-another-strong-password

# ---- Supabase warehouse (your data) ----
# Supabase Dashboard -> Project -> Connect. Use the CONNECTION POOLER credentials
# (Session mode, port 5432) so Metabase's persistent connections don't exhaust the
# direct-connection limit. The user looks like: postgres.<project-ref>
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=your-supabase-db-password

# Full DSN for the Python side (ingestion + MCP). Same creds; sslmode=require is
# mandatory for Supabase. Keep it consistent with the SUPABASE_DB_* values above.
WAREHOUSE_DSN=postgresql://postgres.<project-ref>:your-supabase-db-password@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
